# 敏感配置：.env 里有真实 API Key，绝不入库
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ruff_cache/
.pytest_cache/

# 素材上传落盘（体积大、可重新上传）
server/data/uploads/*
!server/data/uploads/.gitkeep

# SQLite 运行数据库（开发库可随时迁移重建，不入库）
server/data/*.db
server/data/*.db-journal
server/nohup.out
server/data/uploads

# 设备端构建产物与本地缓存
device-app/build/
device-app/.build/
*.app

# 编辑器原子保存残留（形如 .!12345!main.py）
.!*
._*

# macOS
.DS_Store
