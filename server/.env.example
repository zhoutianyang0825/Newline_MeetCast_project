# MeetCast 服务端环境变量样例（复制成 .env 后填值，.env 不要提交到 git）
#
#   cp .env.example .env
#
# 所有键都可被同名系统环境变量覆盖（容器部署时用环境变量，本地开发用 .env）。

# ---------- LLM（F5.1 文案 / F3.5 智能选版式） ----------
# 走 OpenAI 兼容协议，DeepSeek / 阿里百炼 / vLLM / Ollama 都能用。
# 不填 MEETCAST_LLM_API_KEY → 自动回落模板文案 + 规则选版（功能不坏，只是不"聪明"）。
MEETCAST_LLM_BASE_URL=https://api.deepseek.com/v1
MEETCAST_LLM_API_KEY=
MEETCAST_LLM_MODEL=deepseek-chat
# 单次调用超时（秒）：PRD 要求生成 ≤10s、失败 5s 内降级，这里 6s 留余量
MEETCAST_LLM_TIMEOUT=6

# 兼容 HHT/其他项目已有的通用键名（下面三个也能生效，上面优先）
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# ---------- Microsoft Graph（F2.1 日历 / F2.3 会议室 / F4.7 邮件） ----------
# 1=用 fixture 假日历；0=真调 Graph（需要下面三个凭据，M6 试点才有）
MEETCAST_GRAPH_MOCK=1
MEETCAST_GRAPH_TENANT_ID=
MEETCAST_GRAPH_CLIENT_ID=
MEETCAST_GRAPH_CLIENT_SECRET=
# 1=邮件只打印落库；0=走 Graph sendMail（需 Mail.Send）
MEETCAST_MAIL_MOCK=1

# ---------- 服务地址 ----------
# 设备页 / 素材 url 前缀，换机器演示时改这里
MEETCAST_PUBLIC_BASE=http://localhost:8000

# ---------- 演示用开关 ----------
# 首场会议几分钟后开始（彩排调成 3，约 2 分钟后自动切屏）
MEETCAST_FIRST_MEETING_MIN=8
# 调度节拍（秒）：demo 60，生产 300
MEETCAST_TICK_SEC=60
# 日历源故障注入：expired / rate_limited（验证 3001/3002）
MEETCAST_CALENDAR_FAULT=
# JWT 签名密钥（生产必须换）
MEETCAST_JWT_SECRET=dev-secret-change-me
